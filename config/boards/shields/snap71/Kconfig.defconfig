if SHIELD_SNAP71_LEFT

config ZMK_KEYBOARD_NAME
    default "snap71"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif # SHIELD_SNAP71_LEFT

if SHIELD_SNAP71_LEFT || SHIELD_SNAP71_RIGHT

config ZMK_SPLIT
    default y

endif # SHIELD_SNAP71_LEFT || SHIELD_SNAP71_RIGHT

if SHIELD_SNAP71_RIGHT
    config ZMK_DISPLAY
        default y
endif

if LVGL

config LV_Z_VDB_SIZE
    int
    default 64

config LV_Z_DPI
    int
    default 148

config LV_Z_BITS_PER_PIXEL
    int
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL